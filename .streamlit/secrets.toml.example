# LOCAL TESTING ONLY.
# Copy this file to .streamlit/secrets.toml and fill in your real key
# to test Streamlit's secrets mechanism locally, the same way it will
# be read once deployed on Streamlit Community Cloud.
#
# NEVER commit the real secrets.toml to git — add .streamlit/secrets.toml
# to your .gitignore. On Streamlit Cloud, you paste this content into
# the app's Settings -> Secrets box in the dashboard instead of a file.

GROQ_API_KEY = "gsk_your_real_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"
